# Tamil Nadu Politics Brief - Environment Configuration
# Copy this file to .env for local testing. Never commit your real .env file.
# In GitHub Actions, store GEMINI_API_KEY in Repository Secrets.

# AI Provider: "gemini" (default) or "extractive_fallback" (zero-API offline mode)
AI_PROVIDER=gemini

# Get a free API key from https://aistudio.google.com/ (DO NOT link a billing card)
GEMINI_API_KEY=your_free_tier_gemini_api_key_here

# Eligible Free-Tier Model
GEMINI_MODEL=gemini-2.5-flash

# Strict Zero-Cost Guardrails
MAX_API_CALLS_PER_RUN=2
ALLOW_SEARCH_GROUNDING=false
HTTP_TIMEOUT_SECONDS=15
USER_AGENT=TamilNaduPoliticsBriefBot/1.0 (+https://github.com/your-username/tamil-nadu-politics-brief; public-interest-nonprofit-research)